A shared resource's memory was made exportable and exported at once, and CreateSharedHandle exported it
again, whether or not the device has VK_KHR_external_memory_win32. Every game's Vulkan on the console is the GPU
broker's client, which has no Win32 external memory or semaphores: Wine's allocation with an export request
failed (win32u patch 2407 turns it into an ordinary one), and vkGetMemoryWin32HandleKHR is NULL, so a game that
makes a shared resource at start crashed. Without the extension a shared resource is now ordinary memory,
CreateSharedHandle returns E_NOTIMPL and OpenSharedHandle opens nothing; the same for fences without
VK_KHR_external_semaphore_win32, and a shared fence the host cannot export is an ordinary fence instead of
failing CreateFence.
The problem was found by reading PC5's vkd3d-proton 0002 and prospero-win 0054 (github.com/bornaradusin/PC5 at
81323dc3, LGPL-2.1); this change is independently written.

--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -6664,6 +6664,13 @@
             return DXGI_ERROR_INVALID_CALL;
         }
 
+        /* PS5: its memory is ordinary without VK_KHR_external_memory_win32 (resource.c). */
+        if (!device->vk_info.KHR_external_memory_win32)
+        {
+            ID3D12Resource_Release(resource_iface);
+            return E_NOTIMPL;
+        }
+
         if (D3DKMTShareObjects(1, &resource->kmt_local, &attr, access, handle) == STATUS_SUCCESS)
         {
             ID3D12Resource_Release(resource_iface);
@@ -6735,6 +6742,13 @@
 
         fence = shared_impl_from_ID3D12Fence(fence_iface);
 
+        /* PS5: without VK_KHR_external_semaphore_win32, vkGetSemaphoreWin32HandleKHR is NULL. */
+        if (!device->vk_info.KHR_external_semaphore_win32)
+        {
+            ID3D12Fence_Release(fence_iface);
+            return E_NOTIMPL;
+        }
+
         if (D3DKMTShareObjects(1, &fence->kmt_local, &attr, access, handle) == STATUS_SUCCESS)
         {
             ID3D12Fence_Release(fence_iface);
@@ -6787,6 +6801,15 @@
     TRACE("iface %p, handle %p, riid %s, object %p\n",
             iface, handle, debugstr_guid(riid), object);
 
+    /* PS5: nothing can be imported without Win32 external memory or semaphores (the GPU broker's Vulkan client). */
+    if ((IsEqualGUID(riid, &IID_ID3D12Resource) && !device->vk_info.KHR_external_memory_win32) ||
+            (IsEqualGUID(riid, &IID_ID3D12Fence) && !device->vk_info.KHR_external_semaphore_win32))
+    {
+        WARN("Cannot open shared handle %p without Win32 external handles.\n", handle);
+        *object = NULL;
+        return E_NOTIMPL;
+    }
+
     if (IsEqualGUID(riid, &IID_ID3D12Resource))
     {
         struct DxvkSharedTextureMetadata metadata;
