diff --git a/src/d3d9/d3d9_local_share.cpp b/src/d3d9/d3d9_local_share.cpp
new file mode 100644
index 0000000..437f5cc
--- /dev/null
+++ b/src/d3d9/d3d9_local_share.cpp
@@ -0,0 +1,55 @@
+#include "d3d9_local_share.h"
+
+#include "../util/log/log.h"
+
+namespace dxvk {
+
+  using GetLocalShareDeviceFn = void* (WINAPI *)(uint32_t vendorId, uint32_t deviceId);
+
+  Rc<DxvkDevice> D3D9FindD3D11Device(const Rc<DxvkAdapter>& adapter) {
+#ifdef _WIN32
+    HMODULE d3d11 = ::GetModuleHandleW(L"d3d11.dll");
+
+    if (!d3d11)
+      return nullptr;
+
+    auto getDevice = reinterpret_cast<GetLocalShareDeviceFn>(
+      reinterpret_cast<void*>(::GetProcAddress(d3d11, "DXVKLocalShareGetDevice")));
+
+    if (!getDevice)
+      return nullptr;
+
+    const DxvkAdapterInfo info = adapter->info();
+    DxvkDevice* raw = static_cast<DxvkDevice*>(getDevice(info.vendorId, info.deviceId));
+
+    if (!raw)
+      return nullptr;
+
+    /* The export hands out a reference of its own; the Rc takes one, so give that one back. */
+    Rc<DxvkDevice> device(raw);
+    raw->decRef();
+    return device;
+#else
+    return nullptr;
+#endif
+  }
+
+
+  void D3D9PinD3D11Module() {
+#ifdef _WIN32
+    HMODULE pinned = nullptr;
+    ::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_PIN, L"d3d11.dll", &pinned);
+    Logger::info("D3D9: running on the Vulkan device of a Direct3D 11 device of this process");
+#endif
+  }
+
+
+  void D3D9PinThisModule() {
+#ifdef _WIN32
+    HMODULE pinned = nullptr;
+    ::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_PIN | GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+      reinterpret_cast<LPCWSTR>(&D3D9PinThisModule), &pinned);
+#endif
+  }
+
+}
