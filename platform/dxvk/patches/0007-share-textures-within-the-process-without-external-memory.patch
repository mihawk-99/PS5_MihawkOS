diff --git a/src/dxvk/dxvk_local_share.h b/src/dxvk/dxvk_local_share.h
new file mode 100644
index 0000000..3fd828c
--- /dev/null
+++ b/src/dxvk/dxvk_local_share.h
@@ -0,0 +1,129 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+
+#include "../util/util_likely.h"
+#include "../util/rc/util_rc.h"
+#include "../util/rc/util_rc_ptr.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Textures shared between devices of one process
+   *
+   * Where the driver cannot export an image's memory as a Win32 handle (no
+   * VK_KHR_external_memory_win32: the console's), a texture one device makes
+   * shared cannot be opened through its handle by another device. When a
+   * Direct3D 9Ex device and a Direct3D 11 device of the process run on the same
+   * DxvkDevice, they can share the image itself: the texture is listed here
+   * under a handle of its own, and OpenSharedResource finds it by that handle.
+   *
+   * The table is header-only and lives in the DxvkDevice (DxvkLocalShares), so
+   * d3d9.dll and d3d11.dll, which each carry their own copy of the code, read
+   * and write the same table through the same layout. It is a template on the
+   * image and the mutex only so that it can be tested without Vulkan.
+   */
+  struct DxvkLocalShareInfo {
+    uint32_t width      = 0;
+    uint32_t height     = 0;
+    uint32_t mipLevels  = 0;
+    uint32_t arraySize  = 0;
+    uint32_t dxgiFormat = 0;  /* DXGI_FORMAT of the texture as Direct3D 11 names it */
+    uint32_t bindFlags  = 0;  /* D3D11_BIND_* the texture is shared with */
+    uint32_t miscFlags  = 0;  /* D3D11_RESOURCE_MISC_* */
+  };
+
+  template<typename Image, typename Mutex = std::mutex>
+  class DxvkLocalShareTable {
+    /* Handles are small numbers in a range no Windows handle of this process falls in:
+     * NT handles are small multiples of four, kernel-mode handles have bit 30 set. */
+    constexpr static uintptr_t FirstHandle = 0x7da50004u;
+    constexpr static uint32_t  MaxEntries  = 0x3fffu;
+
+    struct Entry {
+      Rc<Image>          image;
+      DxvkLocalShareInfo info;
+    };
+
+  public:
+
+    /** What \ref add returns when the table is full: INVALID_HANDLE_VALUE */
+    static void* invalidHandle() {
+      return reinterpret_cast<void*>(~uintptr_t(0));
+    }
+
+    /** Whether a handle is in the range this table hands out (not whether it is listed now) */
+    static bool isLocalHandle(void* handle) {
+      uintptr_t value = reinterpret_cast<uintptr_t>(handle);
+      return value >= FirstHandle && value < FirstHandle + (uintptr_t(MaxEntries) << 2) && !(value & 3u);
+    }
+
+    /**
+     * \brief Lists a shared image
+     * \returns The handle for it, or \ref invalidHandle when the table is full
+     */
+    void* add(const Rc<Image>& image, const DxvkLocalShareInfo& info) {
+      std::lock_guard<Mutex> lock(m_mutex);
+
+      if (m_entries.size() >= MaxEntries)
+        return invalidHandle();
+
+      uintptr_t handle;
+
+      do {
+        m_next = (m_next % MaxEntries) + 1;
+        handle = FirstHandle + (uintptr_t(m_next - 1) << 2);
+      } while (m_entries.find(handle) != m_entries.end());
+
+      m_entries.emplace(handle, Entry { image, info });
+      return reinterpret_cast<void*>(handle);
+    }
+
+    /**
+     * \brief Looks a handle up
+     * \returns Whether the handle names a listed image
+     */
+    bool find(void* handle, Rc<Image>* image, DxvkLocalShareInfo* info) const {
+      std::lock_guard<Mutex> lock(m_mutex);
+
+      auto entry = m_entries.find(reinterpret_cast<uintptr_t>(handle));
+
+      if (entry == m_entries.end())
+        return false;
+
+      if (image)
+        *image = entry->second.image;
+
+      if (info)
+        *info = entry->second.info;
+
+      return true;
+    }
+
+    /**
+     * \brief Takes an image off the list
+     *
+     * Textures that were opened keep the image alive through their own references.
+     */
+    void remove(void* handle) {
+      std::lock_guard<Mutex> lock(m_mutex);
+      m_entries.erase(reinterpret_cast<uintptr_t>(handle));
+    }
+
+    size_t count() const {
+      std::lock_guard<Mutex> lock(m_mutex);
+      return m_entries.size();
+    }
+
+  private:
+
+    mutable Mutex                        m_mutex;
+    std::unordered_map<uintptr_t, Entry> m_entries;
+    uint32_t                             m_next = 0;
+
+  };
+
+}
