new file mode 100644
index 0000000..0589d79
--- /dev/null
+++ b/src/d3d9/d3d9_local_share.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "../dxvk/dxvk_adapter.h"
+#include "../dxvk/dxvk_device.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Finds the Vulkan device of a Direct3D 11 device in this process
+   *
+   * Asks d3d11.dll, if the process loaded it, for the DxvkDevice of a live Direct3D 11 device on the
+   * same GPU as \c adapter (d3d11.dll exports DXVKLocalShareGetDevice for this). The caller decides
+   * whether to run on it, and then calls \ref D3D9PinD3D11Module.
+   *
+   * \param [in] adapter The adapter the Direct3D 9Ex device is made on
+   * \returns The device to run on, or \c nullptr
+   */
+  Rc<DxvkDevice> D3D9FindD3D11Device(const Rc<DxvkAdapter>& adapter);
+
+  /**
+   * \brief Keeps d3d11.dll loaded
+   *
+   * Once a Direct3D 9Ex device runs on a Direct3D 11 device's Vulkan device, the code that device
+   * is made of is d3d11.dll's: it stays loaded for good.
+   */
+  void D3D9PinD3D11Module();
+
+  /**
+   * \brief Keeps the calling module loaded
+   *
+   * A shared texture's image outlives the call that made it, and the code that frees it is this
+   * module's, so d3d9.dll stays loaded once it has listed one.
+   */
+  void D3D9PinThisModule();
+
+}
