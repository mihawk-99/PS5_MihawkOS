diff --git a/src/d3d11/d3d11_local_share.cpp b/src/d3d11/d3d11_local_share.cpp
new file mode 100644
index 0000000..c9b02aa
--- /dev/null
+++ b/src/d3d11/d3d11_local_share.cpp
@@ -0,0 +1,41 @@
+#include <algorithm>
+#include <vector>
+
+#include "d3d11_local_share.h"
+
+namespace dxvk {
+
+  static dxvk::mutex             g_localShareMutex;
+  static std::vector<DxvkDevice*> g_localShareDevices;
+
+
+  void D3D11LocalShareAdd(DxvkDevice* device) {
+    std::lock_guard<dxvk::mutex> lock(g_localShareMutex);
+    g_localShareDevices.push_back(device);
+  }
+
+
+  void D3D11LocalShareRemove(DxvkDevice* device) {
+    std::lock_guard<dxvk::mutex> lock(g_localShareMutex);
+    g_localShareDevices.erase(
+      std::remove(g_localShareDevices.begin(), g_localShareDevices.end(), device),
+      g_localShareDevices.end());
+  }
+
+
+  DxvkDevice* D3D11LocalShareFind(uint32_t vendorId, uint32_t deviceId) {
+    std::lock_guard<dxvk::mutex> lock(g_localShareMutex);
+
+    for (auto i = g_localShareDevices.rbegin(); i != g_localShareDevices.rend(); ++i) {
+      const DxvkAdapterInfo info = (*i)->adapter()->info();
+
+      if (info.vendorId == vendorId && info.deviceId == deviceId) {
+        (*i)->incRef();
+        return *i;
+      }
+    }
+
+    return nullptr;
+  }
+
+}
