+
+  HANDLE D3D9CommonTexture::ListLocalShare() {
+    // What a Direct3D 11 device is told the texture is (the formats shared textures may have, as for a handle).
+    DxvkLocalShareInfo info;
+
+    switch (m_desc.Format) {
+      case D3D9Format::A2B10G10R10:   info.dxgiFormat = DXGI_FORMAT_R10G10B10A2_UNORM; break;
+      case D3D9Format::A16B16G16R16F: info.dxgiFormat = DXGI_FORMAT_R16G16B16A16_FLOAT; break;
+      case D3D9Format::A8B8G8R8:
+      case D3D9Format::X8B8G8R8:      info.dxgiFormat = DXGI_FORMAT_R8G8B8A8_UNORM; break;
+      case D3D9Format::A8R8G8B8:      info.dxgiFormat = DXGI_FORMAT_B8G8R8A8_UNORM; break;
+      case D3D9Format::X8R8G8B8:      info.dxgiFormat = DXGI_FORMAT_B8G8R8X8_UNORM; break;
+      default:
+        Logger::warn(str::format("D3D9: Unsupported format for shared textures: ", m_desc.Format));
+        return INVALID_HANDLE_VALUE;
+    }
+
+    info.width     = m_desc.Width;
+    info.height    = m_desc.Height;
+    info.mipLevels = m_desc.MipLevels;
+    info.arraySize = m_desc.ArraySize;
+    info.bindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    info.miscFlags = D3D11_RESOURCE_MISC_SHARED;
+
+    HANDLE handle = m_device->GetDXVKDevice()->localShares().add(m_image, info);
+
+    if (handle == INVALID_HANDLE_VALUE) {
+      Logger::warn("D3D9: Too many shared textures");
+      return handle;
+    }
+
+    m_localShareHandle = handle;
+    m_image->setLocalShared();
+    Logger::info(str::format("D3D9: shared texture ", info.width, "x", info.height, " listed for this process as ", handle));
+    D3D9PinThisModule();
+    return handle;
+  }
