+  bool D3D9CommonTexture::WantsLocalShare(const HANDLE* pSharedHandle) const {
+    // Only a new shared texture (no handle given yet) can be listed; opening a handle is the other way round.
+    return pSharedHandle
+        && (*pSharedHandle == nullptr || *pSharedHandle == INVALID_HANDLE_VALUE)
+        && m_device->GetDXVKDevice()->localSharingActive();
+  }
