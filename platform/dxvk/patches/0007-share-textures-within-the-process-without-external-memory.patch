+
+  void D3D11CommonTexture::CheckLocalShareImage(const DxvkImage& image, const DxvkImageCreateInfo& wanted) const {
+    // The image was made for another API from its own description; it serves this one if it is what this
+    // description would make: the same format and size, and every use this description asks for.
+    const DxvkImageCreateInfo& have = image.info();
+    const VkImageUsageFlags needed = wanted.usage & ~(VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+    std::string mismatch;
+
+    if (have.format != wanted.format)
+      mismatch += str::format("\n  Format:  ", have.format, ", this description makes ", wanted.format);
+
+    if (have.extent.width != wanted.extent.width || have.extent.height != wanted.extent.height || have.extent.depth != wanted.extent.depth)
+      mismatch += str::format("\n  Extent:  ", have.extent.width, "x", have.extent.height, "x", have.extent.depth,
+                              ", this description makes ", wanted.extent.width, "x", wanted.extent.height, "x", wanted.extent.depth);
+
+    if (have.numLayers != wanted.numLayers || have.mipLevels != wanted.mipLevels)
+      mismatch += str::format("\n  Layers and levels:  ", have.numLayers, " and ", have.mipLevels,
+                              ", this description makes ", wanted.numLayers, " and ", wanted.mipLevels);
+
+    if (have.sampleCount != wanted.sampleCount)
+      mismatch += str::format("\n  Samples:  ", have.sampleCount, ", this description makes ", wanted.sampleCount);
+
+    if ((have.usage & needed) != needed)
+      mismatch += str::format("\n  Usage:  ", std::hex, have.usage, ", this description needs ", needed, std::dec);
+
+    if (!mismatch.empty())
+      throw DxvkError(str::format("D3D11: The texture shared within the process does not match its description:", mismatch));
+  }
   
   
