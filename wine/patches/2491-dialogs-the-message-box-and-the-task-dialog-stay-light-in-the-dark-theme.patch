     SetPropW( hwnd, L"pw_msg_font", font );
+    /* The prototype's message box keeps its light caption in the dark theme too (win32u defwnd.c "pw_light_frame"). */
+    SetPropW( hwnd, L"pw_light_frame", (HANDLE)1 );
     {
         HWND text = GetDlgItem( hwnd, MSGBOX_IDTEXT );
