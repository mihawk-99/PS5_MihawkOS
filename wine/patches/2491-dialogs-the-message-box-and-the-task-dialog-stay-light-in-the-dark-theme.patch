From fd8932d43720dc58d36b3a5601105aa19dc77b0b Mon Sep 17 00:00:00 2001
From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Date: Sat, 7 Nov 2026 17:00:00 -0500
Subject: [PATCH] win32u, uxtheme, user32, comctl32: the message box and the
 task dialog stay light in the dark theme

The prototype keeps its classic dialogs light in the dark theme (the reference's dark captures of the message box and
the task dialog are light); in MihawkOS's dark theme their caption bars went dark and the task dialog whole
(shell81-base-05: message box 53.3% light, 32.2% dark; task dialog 14.1% and 4.9%).

- dlls/win32u/defwnd.c: a window with the property "pw_light_frame" has the light theme's caption (bar #eef2f8 active,
  #f3f3f3 inactive, title #1a1a1a and #868686, PS5_Proton themes/windows11/appearance.json) whatever the theme; its
  frame's visible pixel too. Every other window is drawn as before.
- dlls/uxtheme/window.c: such a window's caption buttons come from the theme's MihawkLight::Window class, the light
  variant's (PS5_Proton tools/build-wine-theme.py writes every light class again as MihawkLight:: in both variants).
- dlls/user32/msgbox.c: the message box sets it. A button's footer is filled before its blended sprite: a label drawn at
  the template's place showed through Cancel and doubled Yes and No (shell81-base-07).
- dlls/comctl32_v6/taskdialog.c: the task dialog sets it and gives its controls the MihawkLight classes; its page is
  white and its footer, under the verification box and the buttons, #f3f3f3, with #1a1a1a text; the main instruction
  is the prototype's 16 px regular (it was 1.25 times the message font, bold) in the theme's instruction colour.
---
 dlls/comctl32_v6/taskdialog.c | 89 +++++++++++++++++++++++++++++++++--
 dlls/user32/msgbox.c          |  6 +++
 dlls/uxtheme/window.c         |  5 +-
 dlls/win32u/defwnd.c          | 65 +++++++++++++++++++------
 4 files changed, 147 insertions(+), 18 deletions(-)

diff --git a/dlls/comctl32_v6/taskdialog.c b/dlls/comctl32_v6/taskdialog.c
index 9354a47..2020a50 100644
--- a/dlls/comctl32_v6/taskdialog.c
+++ b/dlls/comctl32_v6/taskdialog.c
@@ -597,9 +597,10 @@ static void taskdialog_add_main_instruction(struct taskdialog_info *dialog_info)
 
     ncm.cbSize = sizeof(ncm);
     SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, ncm.cbSize, &ncm, 0);
-    /* 1.25 times the height */
-    ncm.lfMessageFont.lfHeight = ncm.lfMessageFont.lfHeight * 5 / 4;
-    ncm.lfMessageFont.lfWeight = FW_BOLD;
+    /* PS5_Proton: the prototype's main instruction (prototypes/windows11-shell css/dialogs.css .dlg-task-instr):
+     * 16 px over the 12 px message font, regular weight, in the theme's instruction colour (WM_CTLCOLORSTATIC) */
+    ncm.lfMessageFont.lfHeight = ncm.lfMessageFont.lfHeight * 4 / 3;
+    ncm.lfMessageFont.lfWeight = FW_NORMAL;
     dialog_info->main_instruction_font = CreateFontIndirectW(&ncm.lfMessageFont);
 
     dialog_info->main_instruction =
@@ -1207,6 +1208,67 @@ static void taskdialog_destroy(struct taskdialog_info *dialog_info)
     Free(dialog_info->collapsed_text);
 }
 
+/* PS5_Proton: the prototype's task dialog is light in both themes (css/dialogs.css .dlg-task, the reference's dark
+ * capture): a white page, the #f3f3f3 footer under the verification box and the buttons, its text #1a1a1a, the light
+ * caption (win32u "pw_light_frame") and the light variant's controls (the theme's MihawkLight classes). */
+#define PW_TASK_PAGE RGB(0xff, 0xff, 0xff)
+#define PW_TASK_FOOT RGB(0xf3, 0xf3, 0xf3)
+#define PW_TASK_TEXT RGB(0x1a, 0x1a, 0x1a)
+
+static BOOL CALLBACK pw_task_light_child(HWND child, LPARAM unused)
+{
+    SetWindowTheme(child, L"MihawkLight", NULL);
+    return TRUE;
+}
+
+/* The footer's top in client coordinates: above the verification box and the buttons, whichever is higher; or the
+ * client's bottom when the dialog has neither. */
+static LONG pw_task_footer_top(const struct taskdialog_info *dialog_info)
+{
+    RECT client, rect;
+    LONG top;
+    INT i;
+
+    GetClientRect(dialog_info->hwnd, &client);
+    top = client.bottom;
+    for (i = -1; i < dialog_info->button_count; i++)
+    {
+        HWND item = i < 0 ? dialog_info->verification_box : dialog_info->buttons[i];
+        if (!item || !IsWindowVisible(item)) continue;
+        GetWindowRect(item, &rect);
+        MapWindowPoints(HWND_DESKTOP, dialog_info->hwnd, (POINT *)&rect, 2);
+        top = min(top, rect.top - dialog_info->m.v_spacing * 2);
+    }
+    return max(top, 0);
+}
+
+static HBRUSH pw_task_brush(COLORREF colour)
+{
+    static HBRUSH page, foot;
+    if (colour == PW_TASK_FOOT) return foot ? foot : (foot = CreateSolidBrush(PW_TASK_FOOT));
+    return page ? page : (page = CreateSolidBrush(PW_TASK_PAGE));
+}
+
+static INT_PTR pw_task_colour(const struct taskdialog_info *dialog_info, HDC hdc, HWND control)
+{
+    COLORREF text = PW_TASK_TEXT, back = PW_TASK_PAGE;
+    RECT rect;
+
+    GetWindowRect(control, &rect);
+    MapWindowPoints(HWND_DESKTOP, dialog_info->hwnd, (POINT *)&rect, 2);
+    if (rect.top >= pw_task_footer_top(dialog_info)) back = PW_TASK_FOOT;
+    if (control == dialog_info->main_instruction)
+    {
+        HTHEME theme = OpenThemeData(NULL, L"MihawkLight::TaskDialog");
+        if (!theme || FAILED(GetThemeColor(theme, TDLG_MAININSTRUCTIONPANE, 0, TMT_TEXTCOLOR, &text)))
+            text = RGB(0x00, 0x3e, 0x92);
+        if (theme) CloseThemeData(theme);
+    }
+    SetTextColor(hdc, text);
+    SetBkColor(hdc, back);
+    return (INT_PTR)pw_task_brush(back);
+}
+
 static INT_PTR CALLBACK taskdialog_proc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
 {
     static const WCHAR taskdialog_info_propnameW[] = L"TaskDialogInfo";
@@ -1303,6 +1365,8 @@ static INT_PTR CALLBACK taskdialog_proc(HWND hwnd, UINT msg, WPARAM wParam, LPAR
             taskdialog_init(dialog_info, hwnd);
 
             SetPropW(hwnd, taskdialog_info_propnameW, dialog_info);
+            SetPropW(hwnd, L"pw_light_frame", (HANDLE)1);
+            EnumChildWindows(hwnd, pw_task_light_child, 0);
             taskdialog_notify(dialog_info, TDN_DIALOG_CONSTRUCTED, 0, 0);
             taskdialog_notify(dialog_info, TDN_CREATED, 0, 0);
             /* Default radio button click notification sent after TDN_CREATED */
@@ -1351,8 +1415,27 @@ static INT_PTR CALLBACK taskdialog_proc(HWND hwnd, UINT msg, WPARAM wParam, LPAR
             }
             return FALSE;
         }
+        case WM_ERASEBKGND:
+            if (dialog_info)
+            {
+                RECT client;
+                LONG top = pw_task_footer_top(dialog_info);
+                GetClientRect(hwnd, &client);
+                FillRect((HDC)wParam, &client, pw_task_brush(PW_TASK_PAGE));
+                client.top = top;
+                FillRect((HDC)wParam, &client, pw_task_brush(PW_TASK_FOOT));
+                SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, TRUE);
+                return TRUE;
+            }
+            return FALSE;
+        case WM_CTLCOLORDLG:
+            return dialog_info ? (INT_PTR)pw_task_brush(PW_TASK_PAGE) : FALSE;
+        case WM_CTLCOLORSTATIC:
+        case WM_CTLCOLORBTN:
+            return dialog_info ? pw_task_colour(dialog_info, (HDC)wParam, (HWND)lParam) : FALSE;
         case WM_DESTROY:
             taskdialog_notify(dialog_info, TDN_DESTROYED, 0, 0);
+            RemovePropW(hwnd, L"pw_light_frame");
             RemovePropW(hwnd, taskdialog_info_propnameW);
             taskdialog_destroy(dialog_info);
             break;
diff --git a/dlls/user32/msgbox.c b/dlls/user32/msgbox.c
