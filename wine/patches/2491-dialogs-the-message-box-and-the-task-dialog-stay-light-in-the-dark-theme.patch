@@ -409,6 +411,9 @@ static void pw_msg_draw_button( HWND hwnd, const DRAWITEMSTRUCT *dis )
 
     if (pressed) sprite = is_default ? PW_DIALOG_BUTTON_DEFAULT_PRESS : PW_DIALOG_BUTTON_NORMAL_PRESS;
     else sprite = is_default ? PW_DIALOG_BUTTON_DEFAULT : PW_DIALOG_BUTTON_NORMAL;
+    /* The sprite is blended: the footer goes under it first, or whatever the button showed before stays (a label
+     * drawn at the template's place showed through Cancel and doubled Yes and No, shell81-base-07). */
+    pw_msg_fill( dis->hDC, &box, PW_MSG_FACE );
     pw_msg_sprite( dis->hDC, sprite, box.left, box.top, box.right - box.left );
     if (GetWindowTextW( dis->hwndItem, label, ARRAY_SIZE(label) ))
     {
@@ -476,6 +481,7 @@ static INT_PTR CALLBACK MSGBOX_DlgProc( HWND hwnd, UINT message,
        if ((HFONT)GetPropW( hwnd, L"pw_msg_font" )) DeleteObject( (HFONT)GetPropW( hwnd, L"pw_msg_font" ) );
        RemovePropW( hwnd, L"pw_msg_font" );
        RemovePropW( hwnd, L"pw_msg_icon" );
+       RemovePropW( hwnd, L"pw_light_frame" );
        return 0;
 
    case WM_COMMAND:
diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
index bb8186b..fe42c9c 100644
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -97,7 +97,10 @@ void WINAPI UXTHEME_NonClientButtonDraw(HWND hwnd, HDC hdc, enum NONCLIENT_BUTTO
 {
     HTHEME theme;
 
-    theme = OpenThemeDataForDpi(NULL, L"Window", GetDpiForWindow(hwnd));
+    /* PS5_Proton: a window that keeps the light caption in the dark theme ("pw_light_frame", win32u defwnd.c) draws
