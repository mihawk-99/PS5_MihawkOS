diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index a9c4d2a..c18ba17 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -1234,8 +1234,44 @@ static HICON get_nc_icon_for_window( HWND hwnd )
     return icon;
 }
 
+/* PS5_Proton: a window the prototype keeps light in the dark theme (the message box and the task dialog, which set the
+ * property "pw_light_frame") has the light theme's caption, as PS5_Proton themes/windows11/appearance.json names it:
+ * the bar #eef2f8 active and #f3f3f3 inactive, the title #1a1a1a and #868686. Every other window has the theme's. */
+static const WCHAR light_frameW[] = {'p','w','_','l','i','g','h','t','_','f','r','a','m','e',0};
+
+static COLORREF caption_color( HWND hwnd, int index )
+{
+    if (hwnd && NtUserGetProp( hwnd, light_frameW ))
+    {
+        switch (index)
+        {
+        case COLOR_ACTIVECAPTION:
+        case COLOR_GRADIENTACTIVECAPTION:   return RGB( 0xee, 0xf2, 0xf8 );
+        case COLOR_INACTIVECAPTION:
+        case COLOR_GRADIENTINACTIVECAPTION: return RGB( 0xf3, 0xf3, 0xf3 );
+        case COLOR_CAPTIONTEXT:             return RGB( 0x1a, 0x1a, 0x1a );
+        case COLOR_INACTIVECAPTIONTEXT:     return RGB( 0x86, 0x86, 0x86 );
+        }
+    }
+    return get_sys_color( index );
+}
+
+static void fill_caption_rect( HWND hwnd, HDC hdc, const RECT *rect, int index )
+{
+    HBRUSH brush;
+
+    if (!hwnd || !NtUserGetProp( hwnd, light_frameW ))
+    {
+        fill_rect( hdc, rect, get_sys_color_brush( index ));
+        return;
+    }
+    brush = NtGdiCreateSolidBrush( caption_color( hwnd, index ), NULL );
+    fill_rect( hdc, rect, brush );
+    NtGdiDeleteObjectApp( brush );
+}
+
 /* Draws the bar part (ie the big rectangle) of the caption */
-static void draw_caption_bar( HDC hdc, const RECT *rect, DWORD style, BOOL active, BOOL gradient )
+static void draw_caption_bar( HWND hwnd, HDC hdc, const RECT *rect, DWORD style, BOOL active, BOOL gradient )
 {
     if (gradient)
     {
@@ -1245,8 +1281,8 @@ static void draw_caption_bar( HDC hdc, const RECT *rect, DWORD style, BOOL activ
 
         static GRADIENT_RECT mesh[] = {{0, 1}, {1, 2}, {2, 3}};
 
-        left  = get_sys_color( active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION );
-        right = get_sys_color( active ? COLOR_GRADIENTACTIVECAPTION : COLOR_GRADIENTINACTIVECAPTION );
+        left  = caption_color( hwnd, active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION );
+        right = caption_color( hwnd, active ? COLOR_GRADIENTACTIVECAPTION : COLOR_GRADIENTINACTIVECAPTION );
         vertices[0].Red   = vertices[1].Red   = GetRValue( left ) << 8;
         vertices[0].Green = vertices[1].Green = GetGValue( left ) << 8;
         vertices[0].Blue  = vertices[1].Blue  = GetBValue( left ) << 8;
@@ -1281,7 +1317,7 @@ static void draw_caption_bar( HDC hdc, const RECT *rect, DWORD style, BOOL activ
     else
     {
         DWORD color = active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION;
-        fill_rect( hdc, rect, get_sys_color_brush( color ));
+        fill_caption_rect( hwnd, hdc, rect, color );
     }
 }
 
@@ -1605,7 +1641,7 @@ static void draw_nc_caption( HDC hdc, RECT *rect, HWND hwnd, DWORD  style,
 
     /* Windows 11: the bar fills the whole caption, with no line beneath it */
     NtUserSystemParametersInfo( SPI_GETGRADIENTCAPTIONS, 0, &gradient, 0 );
-    draw_caption_bar( hdc, &r, style, active, gradient );
+    draw_caption_bar( hwnd, hdc, &r, style, active, gradient );
 
     if ((style & WS_SYSMENU) && !(ex_style & WS_EX_TOOLWINDOW))
     {
@@ -1652,9 +1688,9 @@ static void draw_nc_caption( HDC hdc, RECT *rect, HWND hwnd, DWORD  style,
             hFont = NtGdiHfontCreate( &nclm.lfCaptionFont, sizeof(nclm.lfCaptionFont), 0, 0, NULL );
         hOldFont = NtGdiSelectFont( hdc, hFont );
         if (active)
-            NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( COLOR_CAPTIONTEXT ), NULL );
+            NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, caption_color( hwnd, COLOR_CAPTIONTEXT ), NULL );
         else
-            NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( COLOR_INACTIVECAPTIONTEXT ), NULL );
+            NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, caption_color( hwnd, COLOR_INACTIVECAPTIONTEXT ), NULL );
         NtGdiGetAndSetDCDword( hdc, NtGdiSetBkMode, TRANSPARENT, NULL );
         DrawTextW( hdc, buffer, -1, &r,
                      DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_LEFT );
@@ -1687,7 +1723,7 @@ BOOL WINAPI NtUserDrawCaptionTemp( HWND hwnd, HDC hdc, const RECT *rect, HFONT f
     else
     {
         DWORD style = get_window_long( hwnd, GWL_STYLE );
-        draw_caption_bar( hdc, &rc, style, flags & DC_ACTIVE, flags & DC_GRADIENT );
+        draw_caption_bar( hwnd, hdc, &rc, style, flags & DC_ACTIVE, flags & DC_GRADIENT );
     }
 
     /* drawing icon */
@@ -1717,7 +1753,8 @@ BOOL WINAPI NtUserDrawCaptionTemp( HWND hwnd, HDC hdc, const RECT *rect, HFONT f
             color = COLOR_CAPTIONTEXT;
         else
             color = COLOR_INACTIVECAPTIONTEXT;
-        NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( color ), NULL );
+        NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor,
+                               color == COLOR_BTNTEXT ? get_sys_color( color ) : caption_color( hwnd, color ), NULL );
         NtGdiGetAndSetDCDword( hdc, NtGdiSetBkMode, TRANSPARENT, NULL );
 
         if (font)
@@ -1805,18 +1842,18 @@ static void nc_paint( HWND hwnd, HRGN clip )
     {
         /* Only the frame's innermost pixel shows (get_visible_rect): the window's own colour, which the
          * compositor's 1-pixel border is drawn over, as Windows 11 draws a frame over its backdrop. */
-        HBRUSH brush = get_sys_color_brush( active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION );
+        int color = active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION;
         RECT inside, strip;
 
         get_inside_rect( hwnd, COORDS_WINDOW, &inside, style, ex_style );
         SetRect( &strip, rect.left, rect.top, rect.right, inside.top );
-        fill_rect( hdc, &strip, brush );
+        fill_caption_rect( hwnd, hdc, &strip, color );
         SetRect( &strip, rect.left, inside.bottom, rect.right, rect.bottom );
-        fill_rect( hdc, &strip, brush );
+        fill_caption_rect( hwnd, hdc, &strip, color );
         SetRect( &strip, rect.left, inside.top, inside.left, inside.bottom );
-        fill_rect( hdc, &strip, brush );
+        fill_caption_rect( hwnd, hdc, &strip, color );
         SetRect( &strip, inside.right, inside.top, rect.right, inside.bottom );
-        fill_rect( hdc, &strip, brush );
+        fill_caption_rect( hwnd, hdc, &strip, color );
         rect = inside;
     }
     else
