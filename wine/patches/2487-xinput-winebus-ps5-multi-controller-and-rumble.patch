     }
diff --git a/dlls/winebus.sys/bus_ps5.c b/dlls/winebus.sys/bus_ps5.c
--- a/dlls/winebus.sys/bus_ps5.c
+++ b/dlls/winebus.sys/bus_ps5.c
@@ -15,11 +15,15 @@
 #include "unix_private.h"
 #include "pw_wine_xusb.h"
 
-struct ps5_device { struct unix_device base; int started; };
-static struct ps5_device *device;
+#define PS5_MAX_SLOTS 4
+#define PS5_EXTRA_DISCONNECT_LOOPS 250   /* ~2 s before removing a disconnected player 2..4 controller */
+
+struct ps5_device { struct unix_device base; int started; int slot; };
+static struct ps5_device *devices[PS5_MAX_SLOTS];
 static int stopping;
 static pthread_mutex_t device_lock = PTHREAD_MUTEX_INITIALIZER;
 static int (*read_pad)(unsigned char *);
+static int (*read_pad_slot)(unsigned int, unsigned char *);
 /* The helper's count of what became of each report (pw_wine_input_note, wine/ps5/pw_wine_sink.h in PS5_Proton):
  * queued 0, held back while the device is not started 1, device created 2, removed 3. */
 static void (*note)(int);
@@ -27,9 +31,30 @@
 static int start_kind;           /* the kind until the title sets one: WINE_PS5_HID=1 the DualSense, else the env's Xbox */
 /* An Xbox controller chosen: Windows' HID gamepad for it (pw_wine_xusb.h, patch 2480), from the title's pad slot */
 static int (*read_xbox)(PwWinePad *);
-static struct ps5_device *xbox;
-static int xbox_kind;
+static int (*read_xbox_slot)(unsigned int, PwWinePad *);
+static void (*write_rumble)(UINT32, UINT32);
+static void (*write_rumble_slot)(unsigned int, UINT32, UINT32);
+static struct ps5_device *xboxes[PS5_MAX_SLOTS];
+static int xbox_kinds[PS5_MAX_SLOTS];
 static struct list events = LIST_INIT(events);
+
+static int ps5_read_dualsense(unsigned int slot, unsigned char *report)
+{
+    if (read_pad_slot) return read_pad_slot(slot, report);
+    return !slot && read_pad ? read_pad(report) : 0;
+}
+static int ps5_read_xbox(unsigned int slot, PwWinePad *pad)
+{
+    if (read_xbox_slot) return read_xbox_slot(slot, pad);
+    if (!slot && read_xbox) return read_xbox(pad);
+    memset(pad, 0, sizeof(*pad));
+    return 0;
+}
+static void ps5_send_rumble(unsigned int slot, UINT32 left, UINT32 right)
+{
+    if (write_rumble_slot) write_rumble_slot(slot, left, right);
+    else if (!slot && write_rumble) write_rumble(left, right);
+}
 
 /* USB report 1: six axes, counter, hat, 15 buttons and vendor payload.
  * The vendor payload retains DualSense's public USB layout for SDL HIDAPI. */
@@ -68,9 +93,10 @@
 }
 static void stop(struct unix_device *iface)
 {
+    struct ps5_device *dev = (struct ps5_device *)iface;
     pthread_mutex_lock(&device_lock);
-    if (device == (struct ps5_device *)iface) device = NULL;
-    __atomic_store_n(&((struct ps5_device *)iface)->started, 0, __ATOMIC_RELEASE);
+    if (dev->slot >= 0 && dev->slot < PS5_MAX_SLOTS && devices[dev->slot] == dev) devices[dev->slot] = NULL;
+    __atomic_store_n(&dev->started, 0, __ATOMIC_RELEASE);
     pthread_mutex_unlock(&device_lock);
 }
 static NTSTATUS get_descriptor(struct unix_device *iface, BYTE *buffer, UINT length, UINT *out)
@@ -85,10 +111,27 @@
     io->Status = STATUS_NOT_SUPPORTED;
     io->Information = 0;
 }
+static void output_report(struct unix_device *iface, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
+{
+    struct ps5_device *dev = (struct ps5_device *)iface;
+    if (packet && packet->reportBuffer && packet->reportBufferLen >= 5 &&
+        (packet->reportId == 0x02 || (!packet->reportId && packet->reportBuffer[0] == 0x02)))
+    {
+        const BYTE *buf = packet->reportBuffer;
+        /* DualSense USB output report 0x02: byte 1 valid_flag0 (bits 0..1 enable motors), byte 3 right, byte 4 left. */
+        if (buf[0] == 0x02 && (buf[1] & 0x03))
+            ps5_send_rumble((unsigned int)dev->slot, (UINT32)buf[4] * 257u, (UINT32)buf[3] * 257u);
+        io->Information = packet->reportBufferLen;
+        io->Status = STATUS_SUCCESS;
+        return;
+    }
+    unsupported(iface, packet, io);
+}
 static void feature(struct unix_device *iface, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
 {
-    /* A stable local virtual-device serial, not the user's hardware address. */
-    static const BYTE serial[20] = {9, 1, 0, 0, 0, 0, 2};
+    struct ps5_device *dev = (struct ps5_device *)iface;
+    /* A stable local virtual-device serial per slot, not the user's hardware address. */
+    BYTE serial[20] = {9, 1, 0, 0, 0, 0, (BYTE)(2 + (dev->slot & 0x0f))};
     unsupported(iface, packet, io);
     if (packet->reportId != 9) return;
     if (packet->reportBufferLen < sizeof(serial)) { io->Status = STATUS_BUFFER_TOO_SMALL; return; }
@@ -96,13 +139,14 @@
     io->Information = sizeof(serial);
     io->Status = STATUS_SUCCESS;
 }
-static const struct raw_device_vtbl vtbl = {destroy, start, stop, get_descriptor, unsupported, feature, unsupported};
+static const struct raw_device_vtbl vtbl = {destroy, start, stop, get_descriptor, output_report, feature, unsupported};
 
 static void xbox_stop(struct unix_device *iface)
 {
+    struct ps5_device *dev = (struct ps5_device *)iface;
     pthread_mutex_lock(&device_lock);
-    if (xbox == (struct ps5_device *)iface) xbox = NULL;
-    __atomic_store_n(&((struct ps5_device *)iface)->started, 0, __ATOMIC_RELEASE);
+    if (dev->slot >= 0 && dev->slot < PS5_MAX_SLOTS && xboxes[dev->slot] == dev) xboxes[dev->slot] = NULL;
+    __atomic_store_n(&dev->started, 0, __ATOMIC_RELEASE);
     pthread_mutex_unlock(&device_lock);
 }
 static NTSTATUS xbox_descriptor(struct unix_device *iface, BYTE *buffer, UINT length, UINT *out)
@@ -114,48 +158,72 @@
 }
 static const struct raw_device_vtbl xbox_vtbl = {destroy, start, xbox_stop, xbox_descriptor, unsupported, unsupported, unsupported};
 
-/* The Xbox controller's HID gamepad while kind (0 Xbox 360, 1 Xbox One) is chosen, made at once and kept, connected or
- * not, as the DualSense is; a report goes out whenever the slot's packet moves. device_lock must be held. */
+/* The Xbox controllers' HID gamepads while kind (0 Xbox 360, 1 Xbox One) is chosen: slot 0 is made at once and kept,
+ * connected or not, as the DualSense is; slots 1..3 are created dynamically when connected and removed when disconnected.
+ * device_lock must be held. */
 static void xbox_update(int kind)
 {
-    static UINT32 sent_packet, sent_connected = 2;
-    static unsigned int waits;   /* as the DualSense's: a device stopped without the bus is made again after a second */
-    PwWinePad pad;
-    BYTE report[PW_WINE_XUSB_REPORT];
-    int connected;
-
-    if (xbox && xbox_kind != kind)
+    static UINT32 sent_packet[PS5_MAX_SLOTS], sent_connected[PS5_MAX_SLOTS] = {2, 2, 2, 2};
+    static unsigned int waits[PS5_MAX_SLOTS];   /* as the DualSense's: a device stopped without the bus is made again after a second */
+    static unsigned int disconnect_loops[PS5_MAX_SLOTS];
+    unsigned int slot;
+
+    for (slot = 0; slot < PS5_MAX_SLOTS; ++slot)
     {
-        bus_event_queue_device_removed(&events, &xbox->base);
-        xbox = NULL;
-        waits = 0;   /* the other kind's at once */
+        PwWinePad pad;
+        BYTE report[PW_WINE_XUSB_REPORT];
+        int connected;
+
+        if (xboxes[slot] && xbox_kinds[slot] != kind)
+        {
+            bus_event_queue_device_removed(&events, &xboxes[slot]->base);
+            xboxes[slot] = NULL;
+            waits[slot] = 0;   /* the other kind's at once */
+            disconnect_loops[slot] = 0;
+        }
+        if (kind < 0) continue;
+        connected = ps5_read_xbox(slot, &pad);   /* all zero when not connected: released and centred */
+        if (slot > 0)
+        {
+            if (!connected)
+            {
+                if (xboxes[slot] && ++disconnect_loops[slot] >= PS5_EXTRA_DISCONNECT_LOOPS)
+                {
+                    bus_event_queue_device_removed(&events, &xboxes[slot]->base);
+                    xboxes[slot] = NULL;
+                    disconnect_loops[slot] = 0;
+                    fprintf(stderr, "wine-ps5: Xbox HID gamepad slot %u removed (disconnected)\n", slot);
+                }
+                continue;
+            }
+            disconnect_loops[slot] = 0;
+        }
+        if (!xboxes[slot] && waits[slot]) --waits[slot];
+        else if (!xboxes[slot])
+        {
+            struct device_desc desc = {.vid=0x045e, .pid=kind == 1 ? 0x02ea : 0x028e, .version=kind == 1 ? 0x0408 : 0x0114,
+                .input=-1, .bus_type=BUS_TYPE_USB,
+                .manufacturer={'M','i','c','r','o','s','o','f','t'},
+                .serialnumber={'P','S','5','-','L','O','C','A','L','-',(WCHAR)('1' + slot)}};
+            /* the names DirectInput shows on Windows, which hidclass also gives (device.c) */
+            static const WCHAR x360[] = {'C','o','n','t','r','o','l','l','e','r',' ','(','X','B','O','X',' ','3','6','0',' ','F','o','r',' ','W','i','n','d','o','w','s',')',0};
+            static const WCHAR xone[] = {'C','o','n','t','r','o','l','l','e','r',' ','(','X','b','o','x',' ','O','n','e',' ','F','o','r',' ','W','i','n','d','o','w','s',')',0};
+            memcpy(desc.product, kind == 1 ? xone : x360, kind == 1 ? sizeof(xone) : sizeof(x360));
+            waits[slot] = 125;
+            if (!(xboxes[slot] = raw_device_create(&xbox_vtbl, sizeof(*xboxes[slot])))) continue;
+            xboxes[slot]->slot = (int)slot;
+            xbox_kinds[slot] = kind;
+            sent_connected[slot] = 2;
+            bus_event_queue_device_created(&events, &xboxes[slot]->base, &desc);
+            fprintf(stderr, "wine-ps5: the Xbox controller's HID gamepad %04x:%04x (slot %u) is made\n", desc.vid, desc.pid, slot);
+        }
+        if (!xboxes[slot] || !__atomic_load_n(&xboxes[slot]->started, __ATOMIC_ACQUIRE)) continue;
+        if (connected == (int)sent_connected[slot] && (!connected || pad.packet == sent_packet[slot])) continue;
+        sent_connected[slot] = connected;
+        sent_packet[slot] = pad.packet;
+        pw_wine_xusb_report(&pad, report);
+        bus_event_queue_input_report(&events, &xboxes[slot]->base, report, sizeof(report));
     }
-    if (kind < 0) return;
-    if (!xbox && waits) --waits;
-    else if (!xbox)
-    {
-        struct device_desc desc = {.vid=0x045e, .pid=kind == 1 ? 0x02ea : 0x028e, .version=kind == 1 ? 0x0408 : 0x0114,
-            .input=-1, .bus_type=BUS_TYPE_USB,
-            .manufacturer={'M','i','c','r','o','s','o','f','t'},
-            .serialnumber={'P','S','5','-','L','O','C','A','L','-','1'}};
-        /* the names DirectInput shows on Windows, which hidclass also gives (device.c) */
-        static const WCHAR x360[] = {'C','o','n','t','r','o','l','l','e','r',' ','(','X','B','O','X',' ','3','6','0',' ','F','o','r',' ','W','i','n','d','o','w','s',')',0};
-        static const WCHAR xone[] = {'C','o','n','t','r','o','l','l','e','r',' ','(','X','b','o','x',' ','O','n','e',' ','F','o','r',' ','W','i','n','d','o','w','s',')',0};
-        memcpy(desc.product, kind == 1 ? xone : x360, kind == 1 ? sizeof(xone) : sizeof(x360));
-        waits = 125;
-        if (!(xbox = raw_device_create(&xbox_vtbl, sizeof(*xbox)))) return;
-        xbox_kind = kind;
-        sent_connected = 2;
-        bus_event_queue_device_created(&events, &xbox->base, &desc);
-        fprintf(stderr, "wine-ps5: the Xbox controller's HID gamepad %04x:%04x is made\n", desc.vid, desc.pid);
-    }
-    if (!xbox || !__atomic_load_n(&xbox->started, __ATOMIC_ACQUIRE)) return;
-    connected = read_xbox(&pad);   /* all zero when not connected: released and centred */
-    if (connected == sent_connected && (!connected || pad.packet == sent_packet)) return;
-    sent_connected = connected;
-    sent_packet = pad.packet;
-    pw_wine_xusb_report(&pad, report);
-    bus_event_queue_input_report(&events, &xbox->base, report, sizeof(report));
 }
 
 static int (*thread_is_terminating)(void);
@@ -164,22 +232,29 @@
     thread_is_terminating = dlsym(RTLD_DEFAULT, "ps5_thread_is_terminating");
     fprintf(stderr, "wine-ps5: bus thread %s ps5_thread_is_terminating\n", thread_is_terminating ? "found" : "has no");
     read_pad = dlsym(RTLD_DEFAULT, "pw_wine_dualsense");
+    read_pad_slot = dlsym(RTLD_DEFAULT, "pw_wine_dualsense_slot");
     note = dlsym(RTLD_DEFAULT, "pw_wine_input_note");
     pad_kind = dlsym(RTLD_DEFAULT, "pw_wine_pad_kind");
