-    state->Gamepad.bRightTrigger = pad.right_trigger;
-    state->Gamepad.sThumbLX = pad.thumb_lx;
-    state->Gamepad.sThumbLY = pad.thumb_ly;
-    state->Gamepad.sThumbRX = pad.thumb_rx;
-    state->Gamepad.sThumbRY = pad.thumb_ry;
+    state->Gamepad.wButtons = params.state.buttons;
+    state->Gamepad.bLeftTrigger = params.state.left_trigger;
+    state->Gamepad.bRightTrigger = params.state.right_trigger;
+    state->Gamepad.sThumbLX = params.state.thumb_lx;
+    state->Gamepad.sThumbLY = params.state.thumb_ly;
+    state->Gamepad.sThumbRX = params.state.thumb_rx;
