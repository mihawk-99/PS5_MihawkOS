+    write_rumble_slot = dlsym(RTLD_DEFAULT, "pw_wine_set_rumble_slot");
     {
         const char *hid = getenv("WINE_PS5_HID"), *controller = getenv("WINE_PS5_CONTROLLER");
         start_kind = hid && hid[0] == '1' ? 2 : controller && !strcmp(controller, "xbox-one") ? 1 : 0;
     }
-    return read_pad && read_xbox ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
