From: Mihawk <mihawk@localhost>
Date: Fri, 27 Nov 2026 00:00:00 +0000
Subject: [PATCH] xinput,winebus: ps5: support up to 4 controllers and HID/XInput rumble

Extend PS5 XInput and winebus HID transport from a single controller slot
to 4 slots (XUSER_MAX_COUNT = 4) and wire rumble feedback end-to-end:
- dlls/xinput1_3: add unix_pad_state_slot and unix_pad_rumble_slot (zero-pointer
  structs, no WoW64 thunks needed), per-slot title_pad_vibration[4], and query
  pw_wine_pad_slot / pw_wine_set_rumble_slot for indices 0..3.
- dlls/winebus.sys/bus_ps5.c: expose up to 4 DualSense or Xbox HID devices
  (slot 0 always present as before; slots 1..3 dynamically added/removed as
  extra PS5 users sign in/out, with unique PS5-LOCAL-1..4 serials) and forward
  DualSense USB output report 0x02 vibration bytes to pw_wine_set_rumble_slot.

---
diff --git a/dlls/xinput1_3/unixlib.h b/dlls/xinput1_3/unixlib.h
--- a/dlls/xinput1_3/unixlib.h
+++ b/dlls/xinput1_3/unixlib.h
@@ -38,8 +38,21 @@
     INT16 thumb_ry;
 };
 
+struct xinput_pad_slot_params
+{
+    UINT32 index;
+    struct xinput_pad_state state;
+};
+
 struct xinput_rumble_params
 {
+    UINT32 left;
+    UINT32 right;
+};
+
+struct xinput_rumble_slot_params
+{
+    UINT32 index;
     UINT32 left;
     UINT32 right;
 };
@@ -50,6 +63,8 @@
     unix_pad_state,
     unix_pad_rumble,
     unix_pad_kind,
+    unix_pad_state_slot,
+    unix_pad_rumble_slot,
     unix_funcs_count,
 };
 
diff --git a/dlls/xinput1_3/unixlib.c b/dlls/xinput1_3/unixlib.c
--- a/dlls/xinput1_3/unixlib.c
+++ b/dlls/xinput1_3/unixlib.c
@@ -38,23 +38,46 @@
  * (wine/ps5/pw_wine_sink.h), whose calls ntdll exports; anywhere else they
  * are missing and xinput uses HID. */
 static int (*title_pad)( struct xinput_pad_state *state );
+static int (*title_pad_slot)( UINT32 slot, struct xinput_pad_state *state );
 static void (*title_rumble)( UINT32 left, UINT32 right );
+static void (*title_rumble_slot)( UINT32 slot, UINT32 left, UINT32 right );
 static int (*title_kind)( void );
 
 static NTSTATUS pad_init( void *args )
 {
     title_pad = dlsym( RTLD_DEFAULT, "pw_wine_pad" );
+    title_pad_slot = dlsym( RTLD_DEFAULT, "pw_wine_pad_slot" );
     title_rumble = dlsym( RTLD_DEFAULT, "pw_wine_set_rumble" );
+    title_rumble_slot = dlsym( RTLD_DEFAULT, "pw_wine_set_rumble_slot" );
     title_kind = dlsym( RTLD_DEFAULT, "pw_wine_pad_kind" );
-    return title_pad ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+    return (title_pad_slot || title_pad) ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
 }
 
 static NTSTATUS pad_state( void *args )
 {
     struct xinput_pad_state *state = args;
 
+    if (title_pad_slot)
+    {
+        if (!title_pad_slot( 0, state )) memset( state, 0, sizeof(*state) );
+        return STATUS_SUCCESS;
+    }
     if (!title_pad) return STATUS_NOT_SUPPORTED;
     if (!title_pad( state )) memset( state, 0, sizeof(*state) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS pad_state_slot( void *args )
+{
+    struct xinput_pad_slot_params *params = args;
+
+    if (title_pad_slot)
+    {
+        if (!title_pad_slot( params->index, &params->state )) memset( &params->state, 0, sizeof(params->state) );
+        return STATUS_SUCCESS;
+    }
+    if (!title_pad) return STATUS_NOT_SUPPORTED;
+    if (params->index || !title_pad( &params->state )) memset( &params->state, 0, sizeof(params->state) );
     return STATUS_SUCCESS;
 }
 
@@ -62,8 +85,27 @@
 {
     const struct xinput_rumble_params *params = args;
 
+    if (title_rumble_slot)
+    {
+        title_rumble_slot( 0, params->left, params->right );
+        return STATUS_SUCCESS;
+    }
     if (!title_rumble) return STATUS_NOT_SUPPORTED;
     title_rumble( params->left, params->right );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS pad_rumble_slot( void *args )
+{
+    const struct xinput_rumble_slot_params *params = args;
+
+    if (title_rumble_slot)
+    {
+        title_rumble_slot( params->index, params->left, params->right );
+        return STATUS_SUCCESS;
+    }
+    if (!title_rumble) return STATUS_NOT_SUPPORTED;
+    if (!params->index) title_rumble( params->left, params->right );
     return STATUS_SUCCESS;
 }
 
@@ -80,6 +122,8 @@
     pad_state,
     pad_rumble,
     pad_kind,
+    pad_state_slot,
+    pad_rumble_slot,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
@@ -92,6 +136,8 @@
     pad_state,
     pad_rumble,
     pad_kind,
+    pad_state_slot,
+    pad_rumble_slot,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
