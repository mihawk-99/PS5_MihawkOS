+/* The body's white page and the footer's strip; the prototype's icons over the body's left. */
+static void pw_msg_paint( HWND hwnd )
+{
+    PAINTSTRUCT ps;
+    HDC dc = NtUserBeginPaint( hwnd, &ps );
+    RECT client;
+    int icon = (int)(INT_PTR)GetPropW( hwnd, L"pw_msg_icon" );
+
+    GetClientRect( hwnd, &client );
+    {
+        RECT foot = {0, client.bottom - PW_MSG_FOOT, client.right, client.bottom};
+        pw_msg_fill( dc, &foot, PW_MSG_FACE );
+    }
+    if (icon >= 0) pw_msg_sprite( dc, icon, PW_MSG_LEFT, PW_MSG_TOP, 0 );
+    NtUserEndPaint( hwnd, &ps );
+}
+
+/* A footer button in the prototype's own pixels: normal, the default's 2 px accent ring, and the pressed look. */
+static void pw_msg_draw_button( HWND hwnd, const DRAWITEMSTRUCT *dis )
+{
+    BOOL is_default = !!GetPropW( dis->hwndItem, L"pw_msg_default" );
+    BOOL pressed = !!(dis->itemState & ODS_SELECTED);
+    WCHAR label[64], text[64];
+    RECT box = dis->rcItem;
+    int sprite;
+
+    if (pressed) sprite = is_default ? PW_DIALOG_BUTTON_DEFAULT_PRESS : PW_DIALOG_BUTTON_NORMAL_PRESS;
+    else sprite = is_default ? PW_DIALOG_BUTTON_DEFAULT : PW_DIALOG_BUTTON_NORMAL;
+    pw_msg_sprite( dis->hDC, sprite, box.left, box.top, box.right - box.left );
+    if (GetWindowTextW( dis->hwndItem, label, ARRAY_SIZE(label) ))
+    {
+        const WCHAR *from = label; int at = 0;
+        while (*from) { if (*from != '&') text[at++] = *from; from++; }
+        text[at] = 0;
+        SetBkMode( dis->hDC, TRANSPARENT );
+        SetTextColor( dis->hDC, PW_MSG_INK );
+        {
+            HGDIOBJ prior = SelectObject( dis->hDC, (HFONT)GetPropW( hwnd, L"pw_msg_font" ) );
+            DrawTextW( dis->hDC, text, -1, &box, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX );
+            SelectObject( dis->hDC, prior );
+        }
+    }
+}
 
