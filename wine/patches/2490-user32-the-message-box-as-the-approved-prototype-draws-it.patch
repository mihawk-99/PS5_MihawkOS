+/* The prototype's message box (prototypes/windows11-shell/js/dialogs.js D.messageBox and css/dialogs.css
+ * .dlg-msg): a white body -- 26 px above and below, 24 px left and 30 px right -- with a 32 px dialog icon over a
+ * 42 px column and 12 px text on 16 px lines, then the footer's 49 px strip with its buttons right-aligned, 26 px
+ * tall, 88 px wide at least and 10 px apart, 12 px in from the sides. The dialog stays light in the dark theme, as
+ * the prototype's classic dialogs do. The icons and the four button looks are the prototype's own pixels
+ * (.deps/windows11-theme/pw_dialog_sprites.h, tools/build-dialog-sprites.py). */
+#include "pw_dialog_sprites.h"
+
+enum { PW_MSG_TOP = 26, PW_MSG_BOTTOM = 26, PW_MSG_LEFT = 24, PW_MSG_RIGHT = 30, PW_MSG_ICON = 32,
+       PW_MSG_ICON_COLUMN = 42, PW_MSG_TEXT_MIN = 32, PW_MSG_FOOT = 49, PW_MSG_BUTTON = 26,
+       PW_MSG_BUTTON_MIN = 88, PW_MSG_BUTTON_GAP = 10, PW_MSG_FOOT_PAD = 12, PW_MSG_MIN_W = 180,
+       PW_MSG_TEXT_LIMIT_MIN = 160 };
+
+#define PW_MSG_PAGE  RGB(0xff, 0xff, 0xff)   /* SolidBackgroundFillColorQuarternary */
+#define PW_MSG_FACE  RGB(0xf3, 0xf3, 0xf3)   /* SolidBackgroundFillColorBase */
+#define PW_MSG_INK   RGB(0x1b, 0x1b, 0x1b)   /* TextFillColorPrimary over the page */
+
+static void pw_msg_fill( HDC dc, const RECT *r, COLORREF colour )
+{
+    HBRUSH brush = CreateSolidBrush( colour );
+    if (brush) { FillRect( dc, r, brush ); DeleteObject( brush ); }
+}
+
+/* One prototype icon or button look, its premultiplied pixels blended where it lies; a button wider than its
+ * measured 88 px repeats the uniform column between the 6 px ends. */
+static void pw_msg_sprite( HDC dc, int index, int x, int y, int width )
+{
+    const struct pw_dialog_sprite *sprite = &pw_dialog_sprites[index];
+    BITMAPINFO info = {{sizeof(BITMAPINFOHEADER), sprite->width, -sprite->height, 1, 32, BI_RGB}};
+    BLENDFUNCTION blend = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    void *bits = NULL; HDC source; HGDIOBJ prior;
+    HBITMAP bitmap = CreateDIBSection( dc, &info, DIB_RGB_COLORS, &bits, NULL, 0 );
+
+    if (!bitmap || !bits) { if (bitmap) DeleteObject( bitmap ); return; }
+    memcpy( bits, sprite->bgra, (size_t)sprite->width * sprite->height * 4 );
+    if ((source = CreateCompatibleDC( dc )))
+    {
+        prior = SelectObject( source, bitmap );
+        if (!width || width == sprite->width)
+            GdiAlphaBlend( dc, x, y, sprite->width, sprite->height, source, 0, 0, sprite->width, sprite->height, blend );
+        else
+        {
+            int end = min( width, sprite->width ) / 2;
+            GdiAlphaBlend( dc, x, y, end, sprite->height, source, 0, 0, end, sprite->height, blend );
+            GdiAlphaBlend( dc, x + width - end, y, end, sprite->height, source, sprite->width - end, 0, end, sprite->height, blend );
+            for (int at = end; at < width - end; ++at)
+                GdiAlphaBlend( dc, x + at, y, 1, sprite->height, source, sprite->width / 2, 0, 1, sprite->height, blend );
+        }
+        SelectObject( source, prior ); DeleteDC( source );
+    }
+    DeleteObject( bitmap );
+}
+
+/* The prototype's dialog icon for a message box's style, or -1 (no icon, and MB_USERICON's own stays a static). */
+static int pw_msg_icon( UINT style )
+{
+    switch (style & MB_ICONMASK)
+    {
+    case MB_ICONEXCLAMATION: return PW_DIALOG_ICON_WARNING;
+    case MB_ICONHAND:        return PW_DIALOG_ICON_ERROR;
+    case MB_ICONASTERISK:    return PW_DIALOG_ICON_INFO;
+    case MB_ICONQUESTION:    return PW_DIALOG_ICON_QUESTION;
+    default:                 return -1;
+    }
+}
+
+/* The prototype's text measure: its longest line unwrapped (css/dialogs.css .dlg-msg-text is pre-wrap). */
+static int pw_msg_text_width( HDC dc, const WCHAR *text )
+{
+    RECT line = {0, 0, 0, 0};
+    const WCHAR *start = text, *at;
+    int width = 0;
+
+    for (;;)
+    {
+        for (at = start; *at && *at != '\n'; ++at);
+        line.right = line.bottom = 0;
+        DrawTextW( dc, start, at - start, &line, DT_CALCRECT | DT_SINGLELINE | DT_NOPREFIX );
+        if (line.right > width) width = line.right;
+        if (!*at) break;
+        start = at + 1;
+    }
+    return width;
+}
