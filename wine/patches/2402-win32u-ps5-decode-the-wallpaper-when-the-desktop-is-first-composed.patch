-                background = NULL;
-            }
-            clock_gettime( CLOCK_MONOTONIC, &ended );
-            fprintf( stderr, "wine-ps5: managed wallpaper %s desktop=%ux%u us=%lld\n",
-                     background ? "loaded" : "absent", screen_width, screen_height,
-                     (ended.tv_sec - began.tv_sec) * 1000000ll + (ended.tv_nsec - began.tv_nsec) / 1000 );
-        }
-    }
     present_frame = dlsym( RTLD_DEFAULT, "pw_wine_present" );
     present_origin = dlsym( RTLD_DEFAULT, "pw_wine_present_origin" );
     /* A Windows program the title runs itself beside the broker draws as a helper does (WINE_PS5_TITLE_CLIENT,
