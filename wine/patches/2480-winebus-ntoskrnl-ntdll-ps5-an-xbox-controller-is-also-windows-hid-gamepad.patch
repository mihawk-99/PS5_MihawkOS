-        if (input_len) pos += swprintf(dst + pos, len - pos, input_format, ext->desc.input);
+        if (xinput_hid) pos += swprintf(dst + pos, len - pos, L"&IG_00");
+        else if (input_len) pos += swprintf(dst + pos, len - pos, input_format, ext->desc.input);
     }
 
     return dst;
