diff --git a/dlls/winebus.sys/bus_ps5.c b/dlls/winebus.sys/bus_ps5.c
index 34fe761..b197796 100644
--- a/dlls/winebus.sys/bus_ps5.c
+++ b/dlls/winebus.sys/bus_ps5.c
@@ -6,12 +6,14 @@
 #include "config.h"
 #include <dlfcn.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <unistd.h>
 #include <pthread.h>
 #include <string.h>
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
 #include "unix_private.h"
+#include "pw_wine_xusb.h"
 
 struct ps5_device { struct unix_device base; int started; };
 static struct ps5_device *device;
@@ -22,6 +24,11 @@ static int (*read_pad)(unsigned char *);
  * queued 0, held back while the device is not started 1, device created 2, removed 3. */
 static void (*note)(int);
 static int (*pad_kind)(void);   /* the title's controller kind, switched live (patch 2472); -1: none set */
+static int start_kind;           /* the kind until the title sets one: WINE_PS5_HID=1 the DualSense, else the env's Xbox */
+/* An Xbox controller chosen: Windows' HID gamepad for it (pw_wine_xusb.h, patch 2480), from the title's pad slot */
+static int (*read_xbox)(PwWinePad *);
+static struct ps5_device *xbox;
+static int xbox_kind;
 static struct list events = LIST_INIT(events);
 
 /* USB report 1: six axes, counter, hat, 15 buttons and vendor payload.
@@ -91,6 +98,66 @@ static void feature(struct unix_device *iface, HID_XFER_PACKET *packet, IO_STATU
 }
 static const struct raw_device_vtbl vtbl = {destroy, start, stop, get_descriptor, unsupported, feature, unsupported};
 
+static void xbox_stop(struct unix_device *iface)
+{
+    pthread_mutex_lock(&device_lock);
+    if (xbox == (struct ps5_device *)iface) xbox = NULL;
+    __atomic_store_n(&((struct ps5_device *)iface)->started, 0, __ATOMIC_RELEASE);
+    pthread_mutex_unlock(&device_lock);
+}
+static NTSTATUS xbox_descriptor(struct unix_device *iface, BYTE *buffer, UINT length, UINT *out)
+{
+    *out = sizeof(pw_wine_xusb_descriptor);
+    if (length < sizeof(pw_wine_xusb_descriptor)) return STATUS_BUFFER_TOO_SMALL;
+    memcpy(buffer, pw_wine_xusb_descriptor, sizeof(pw_wine_xusb_descriptor));
+    return STATUS_SUCCESS;
+}
+static const struct raw_device_vtbl xbox_vtbl = {destroy, start, xbox_stop, xbox_descriptor, unsupported, unsupported, unsupported};
+
+/* The Xbox controller's HID gamepad while kind (0 Xbox 360, 1 Xbox One) is chosen, made at once and kept, connected or
+ * not, as the DualSense is; a report goes out whenever the slot's packet moves. device_lock must be held. */
+static void xbox_update(int kind)
+{
+    static UINT32 sent_packet, sent_connected = 2;
+    static unsigned int waits;   /* as the DualSense's: a device stopped without the bus is made again after a second */
+    PwWinePad pad;
+    BYTE report[PW_WINE_XUSB_REPORT];
+    int connected;
+
+    if (xbox && xbox_kind != kind)
+    {
+        bus_event_queue_device_removed(&events, &xbox->base);
+        xbox = NULL;
+        waits = 0;   /* the other kind's at once */
+    }
+    if (kind < 0) return;
+    if (!xbox && waits) --waits;
+    else if (!xbox)
+    {
+        struct device_desc desc = {.vid=0x045e, .pid=kind == 1 ? 0x02ea : 0x028e, .version=kind == 1 ? 0x0408 : 0x0114,
+            .input=-1, .bus_type=BUS_TYPE_USB,
+            .manufacturer={'M','i','c','r','o','s','o','f','t'},
+            .serialnumber={'P','S','5','-','L','O','C','A','L','-','1'}};
+        /* the names DirectInput shows on Windows, which hidclass also gives (device.c) */
+        static const WCHAR x360[] = {'C','o','n','t','r','o','l','l','e','r',' ','(','X','B','O','X',' ','3','6','0',' ','F','o','r',' ','W','i','n','d','o','w','s',')',0};
+        static const WCHAR xone[] = {'C','o','n','t','r','o','l','l','e','r',' ','(','X','b','o','x',' ','O','n','e',' ','F','o','r',' ','W','i','n','d','o','w','s',')',0};
+        memcpy(desc.product, kind == 1 ? xone : x360, kind == 1 ? sizeof(xone) : sizeof(x360));
+        waits = 125;
+        if (!(xbox = raw_device_create(&xbox_vtbl, sizeof(*xbox)))) return;
+        xbox_kind = kind;
+        sent_connected = 2;
+        bus_event_queue_device_created(&events, &xbox->base, &desc);
+        fprintf(stderr, "wine-ps5: the Xbox controller's HID gamepad %04x:%04x is made\n", desc.vid, desc.pid);
+    }
+    if (!xbox || !__atomic_load_n(&xbox->started, __ATOMIC_ACQUIRE)) return;
+    connected = read_xbox(&pad);   /* all zero when not connected: released and centred */
+    if (connected == sent_connected && (!connected || pad.packet == sent_packet)) return;
+    sent_connected = connected;
+    sent_packet = pad.packet;
+    pw_wine_xusb_report(&pad, report);
+    bus_event_queue_input_report(&events, &xbox->base, report, sizeof(report));
+}
+
