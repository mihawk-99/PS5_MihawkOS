+        start_kind = hid && hid[0] == '1' ? 2 : controller && !strcmp(controller, "xbox-one") ? 1 : 0;
+    }
+    return read_pad && read_xbox ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
 }
