@@ -225,14 +225,22 @@ static WCHAR *get_device_id(DEVICE_OBJECT *device)
 
     assert(ext->desc.bus_type < BUS_TYPE_COUNT);
     bus_str = bus_type_str[ext->desc.bus_type];
+    /* PS5 (patch 2480): only the PS5 bus runs (WINE_PS5_HID), and the Xbox controller it makes is Windows' HID gamepad
