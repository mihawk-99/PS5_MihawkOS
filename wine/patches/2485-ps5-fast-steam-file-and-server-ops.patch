+/* Case-insensitive FNV-1a hash of the last path component, or 0 (wildcard) when ambiguous. */
+static unsigned int wb_hash_basename( const OBJECT_ATTRIBUTES *attr )
+{
+    const WCHAR *buf;
+    unsigned int len, start, i, h = 2166136261u;
+
+    if (!attr || !attr->ObjectName || !attr->ObjectName->Buffer || !attr->ObjectName->Length) return 0;
+    buf = attr->ObjectName->Buffer;
+    len = attr->ObjectName->Length / sizeof(WCHAR);
+    while (len && (buf[len - 1] == '\\' || buf[len - 1] == '/')) len--;
+    if (!len) return 0;
+    start = len;
+    while (start && buf[start - 1] != '\\' && buf[start - 1] != '/') start--;
+    len -= start;
+    if (!len || (len == 1 && buf[start] == '.') || (len == 2 && buf[start] == '.' && buf[start + 1] == '.')) return 0;
+    for (i = 0; i < len; i++)
+    {
+        WCHAR c = buf[start + i];
+        if (c == '~' || c == '*' || c == '?') return 0;
+        if (c >= 'A' && c <= 'Z') c += 32;
+        h = (h ^ (c & 0xff)) * 16777619u;
+        if (c >> 8) h = (h ^ (c >> 8)) * 16777619u;
+    }
+    return h ? h : 1;
+}
