+    h = wb_hash_basename( attr );
+    if (!h) return;
+    s = wb_hslot( handle );
+    wb_lock();
+    __atomic_store_n( &wb_hcache[s].handle, handle, __ATOMIC_RELAXED );
+    wb_hcache[s].name_hash = h;
+    wb_hcache[s].kind = 0;
+    wb_unlock();
+}
