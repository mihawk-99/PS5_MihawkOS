+++ b/dlls/xaudio2_7/xaudio_dll.c
@@ -350,6 +350,22 @@
 
 /* Send Wrapping */
 
+/* A send to a voice that was destroyed has no FAudio voice to name: the entry is taken out. */
+static FAudioVoiceSends *forget_gone_sends(FAudioVoiceSends *sends)
+{
+    unsigned int i, kept = 0;
+
+    if(!sends)
+        return NULL;
+    for(i = 0; i < sends->SendCount; ++i){
+        if(!sends->pSends[i].pOutputVoice)
+            continue;
+        sends->pSends[kept++] = sends->pSends[i];
+    }
+    sends->SendCount = kept;
+    return sends;
+}
+
 static FAudioVoiceSends *wrap_voice_sends(const XAUDIO2_VOICE_SENDS *sends)
 {
     FAudioVoiceSends *ret;
@@ -377,7 +393,7 @@
         ret->pSends[i].Flags = sends->pSends[i].Flags;
     }
 #endif
-    return ret;
+    return forget_gone_sends(ret);
 }
 
 static void free_voice_sends(FAudioVoiceSends *sends)
@@ -512,15 +528,42 @@
 
 /* Common Voice Functions */
 
+/* A game goes on calling a voice after DestroyVoice, which does no harm on Windows. Here a destroyed voice has no FAudio
+ * voice any more, and each of its methods answers with nothing (zeros from a getter) instead of reaching freed memory.
+ * Its object stays in the engine's list for reuse, but not at once: a late call comes within moments of the destroy
+ * (the frame, a callback), and until the grace has passed the object is not handed to a new voice, whose state it
+ * would otherwise change. */
+#define LATE_CALL_GRACE_MS 10000
+
+static inline BOOL voice_is_gone(const XA2VoiceImpl *voice)
+{
+    return !voice->faudio_voice;
+}
+
+static inline BOOL slot_is_free(const XA2VoiceImpl *voice, ULONGLONG now)
+{
+    return !voice->in_use && (!voice->gone_at_ms || now - voice->gone_at_ms >= LATE_CALL_GRACE_MS);
+}
+
+#define RETURN_IF_GONE(voice) \
+    do { if (voice_is_gone(voice)) return; } while (0)
+#define RETURN_IF_GONE_WITH(voice, value) \
+    do { if (voice_is_gone(voice)) return (value); } while (0)
+#define RETURN_ZEROED_IF_GONE(voice, out) \
+    do { if (voice_is_gone(voice)) { memset((out), 0, sizeof(*(out))); return; } } while (0)
+
 static inline void destroy_voice(XA2VoiceImpl *This)
 {
+    RETURN_IF_GONE(This);
     if (FAILED(FAudioVoice_DestroyVoiceSafeEXT(This->faudio_voice)))
     {
         ERR("Destroying voice %p failed.\n", This);
         return;
     }
+    This->faudio_voice = NULL;
     free_effect_chain(This->effect_chain);
     This->effect_chain = NULL;
+    This->gone_at_ms = GetTickCount64() | 1;  /* never 0, which means "not destroyed" */
     This->in_use = FALSE;
 }
 
