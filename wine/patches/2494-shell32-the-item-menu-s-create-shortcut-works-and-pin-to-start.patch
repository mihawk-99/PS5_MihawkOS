diff --git a/dlls/shell32/shlview_cmenu.c b/dlls/shell32/shlview_cmenu.c
index 6029d04..ffd8d71 100644
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -38,6 +38,7 @@
 #include "shlwapi.h"
 
 #include "wine/debug.h"
+#include "pw_shell_shortcut.h"   /* Create shortcut and Pin to Start (PS5_Proton wine/ps5, patch 2494) */
 
 WINE_DEFAULT_DEBUG_CHANNEL(shell);
 
@@ -332,6 +333,24 @@ static void DoDelete(ContextMenu *This)
     }
 }
 
+/* Create shortcut and Pin to Start for each selected item that is a file or a folder: a link on the user's Desktop, or in
+ * Start's Programs and pinned (wine/ps5/pw_shell_shortcut.h). The menu had a "Create Link" with no handler behind it. */
+static void DoCreateShortcuts(ContextMenu *This, BOOL pin)
+{
+    WCHAR path[MAX_PATH], link[MAX_PATH];
+    UINT i;
+
+    for (i = 0; i < This->cidl; ++i)
+    {
+        LPITEMIDLIST full = ILCombine(This->pidl, This->apidl[i]);
+
+        if (!full) continue;
+        if (SHGetPathFromIDListW(full, path) && SUCCEEDED(pw_shell_make_shortcut(path, pin ? PW_SHORTCUT_START : PW_SHORTCUT_DESKTOP, link)) && pin)
+            pw_shell_pin_to_start(link);
+        ILFree(full);
+    }
+}
+
 static void do_copy(ContextMenu *This, HWND hwnd, DWORD drop_effect)
 {
     IDataObject *dataobject;
@@ -1019,6 +1038,10 @@ static HRESULT WINAPI ItemMenu_InvokeCommand(
             TRACE("Verb FCIDM_SHVIEW_PROPERTIES\n");
             DoOpenProperties(This, lpcmi->hwnd);
             break;
+        case FCIDM_SHVIEW_CREATELINK:
+        case FCIDM_SHVIEW_PINSTART:
+            DoCreateShortcuts(This, id + FCIDM_BASE == FCIDM_SHVIEW_PINSTART);
+            break;
         default:
             FIXME("Unhandled verb %#x.\n", id);
             return E_INVALIDARG;
@@ -1037,6 +1060,8 @@ static HRESULT WINAPI ItemMenu_InvokeCommand(
             do_paste(This, lpcmi->hwnd);
         else if (strcmp(lpcmi->lpVerb,"properties")==0)
             DoOpenProperties(This, lpcmi->hwnd);
+        else if (!strcmp(lpcmi->lpVerb, "link") || !strcmp(lpcmi->lpVerb, "pintostartscreen"))
+            DoCreateShortcuts(This, lpcmi->lpVerb[0] == 'p');
         else {
             FIXME("Unhandled string verb %s\n",debugstr_a(lpcmi->lpVerb));
             return E_FAIL;
@@ -1074,6 +1099,9 @@ static HRESULT WINAPI ItemMenu_GetCommandString(IContextMenu3 *iface, UINT_PTR c
         case FCIDM_SHVIEW_CREATELINK:
             cmdW = L"link";
             break;
+        case FCIDM_SHVIEW_PINSTART:
+            cmdW = L"pintostartscreen";
+            break;
         case FCIDM_SHVIEW_DELETE:
             cmdW = L"delete";
             break;
