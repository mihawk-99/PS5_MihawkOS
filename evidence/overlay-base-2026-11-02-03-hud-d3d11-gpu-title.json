 "pad_script": [
  "# The statistics HUD over a drawing probe (tools/run-battery.py hud-d3d11-title, hud-d3d11-gpu-title, vk-present-hud64-title):",
  "# the first 10 s of frames without it (perf's baseline), then L3+R3, DOWN to Statistics, CROSS turns it on, CIRCLE closes",
  "# the overlay and the HUD stays over the frames. The title logs what it shows every 10 s (\"hud: fps= ...\"), the broker",
  "# what it costs (\"gpu-hud compose\"); run-console --expect-hud compares them with perf's frame lines.",
  "anchor frame",
  "10 l3 0.3",
  "10 r3 0.3",
  "11 down",
  "11.5 cross",
  "12.5 circle",
  "15 capture",
  "24 capture"
 ],
